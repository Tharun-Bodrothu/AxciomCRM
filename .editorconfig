root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4

[*.{cshtml,html}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
